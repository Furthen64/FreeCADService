# fcadserve — FreeCAD STL -> STEP conversion HTTP service.
#
# Install (as root):
#   install -d -o fcadserve -g fcadserve /var/lib/fcadserve
#   install -o root -g root deploy/fcadserve.service /etc/systemd/system/fcadserve.service
#   systemctl daemon-reload && systemctl enable --now fcadserve
#
# Configuration comes from /etc/fcadserve/fcadserve.conf (EnvironmentFile).
# At minimum set:
#   FCADSERVE_ALLOWED_INPUT_ROOTS=/data/stl
#   FCADSERVE_ALLOWED_OUTPUT_ROOTS=/data/stl
# and optionally FCADSERVE_STATE_ROOT, FCADSERVE_PORT, etc.
#
# Hardening notes:
#  - ProtectSystem=strict makes every path read-only except ReadWritePaths.
#    The flatpak sandbox maps host paths for FreeCAD independently, so
#    write access for the flatpak process follows the HOST paths granted
#    here (state dir) plus anything granted to flatpak by the service user.
#  - NoNewPrivileges=true is safe for flatpak/Xvfb (they do not raise
#    privileges) and neutral for .NET.
#  - MemoryDenyWriteExecute/SystemCallFilter are intentionally NOT set:
#    .NET's JIT needs writable+executable mappings and flatpak uses several
#    syscalls that a strict filter would break.
#  - FreeCAD/Xvfb are spawned in their own setsid process groups but remain
#    in this unit's cgroup, so the default KillMode=control-group removes
#    them on stop/restart. TimeoutStopSec gives the graceful shutdown path
#    time to kill active workers and their X displays first.

[Unit]
Description=fcadserve FreeCAD conversion service
Documentation=file:///usr/lib/fcadserve/README.md
After=network.target

[Service]
Type=simple
User=fcadserve
Group=fcadserve
WorkingDirectory=/usr/lib/fcadserve
EnvironmentFile=-/etc/fcadserve/fcadserve.conf
ExecStart=/usr/share/dotnet/dotnet /usr/lib/fcadserve/fcadserve.dll
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fcadserve
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectClock=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target